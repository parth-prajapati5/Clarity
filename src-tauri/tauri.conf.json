{
  "productName": "Clarity",
  "version": "0.1.0",
  "identifier": "app.clarity.desktop",
  "build": {
    "beforeDevCommand":   "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl":             "http://localhost:1420",
    "frontendDist":       "../dist"
  },
  "app": {
    "windows": [
      {
        "title":     "Clarity - Digital Wellbeing",
        "width":     1280,
        "height":    800,
        "minWidth":  1024,
        "minHeight": 640,
        "resizable": true,
        "center":    true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active":  true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
